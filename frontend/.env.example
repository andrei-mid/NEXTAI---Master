# Copy to .env.local.
# Backend address: the live API, and where `npm run snapshot` downloads from.
VITE_API_URL=http://localhost:8000

# Real data comes from the local copy snapshot/data.json whenever it exists (made by
# `npm run snapshot`). Uncomment to read the live API instead:
# VITE_DATA_SOURCE=live

# No snapshot and no VITE_API_URL: mock data (the team's fixtures).
