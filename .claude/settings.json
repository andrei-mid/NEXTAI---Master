{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ownership_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking file ownership (CODEOWNERS)"
          }
        ]
      }
    ]
  }
}
