# Copy to .env and fill in. Every variable maps to a field in verifirm/core/config.py (case-insensitive).
# Defaults below = zero-service local mode: fixtures, in-memory ports, no API keys needed.

# --- modes
FIXTURE_MODE=1                      # 1 = every adapter reads fixtures/, fictional CUIs accepted. 0 = live sources
# FIXTURES_DIR=fixtures
ENVIRONMENT=local                   # local | demo | aws

# --- logging
LOG_LEVEL=INFO
LOG_JSON=1                          # structured JSON logs with run_id / cui / agent

# --- infrastructure backends (ports -> implementations)
QUEUE_BACKEND=memory                # memory | redis | sqs
CACHE_BACKEND=memory                # memory | redis
OBJECT_STORE_BACKEND=filesystem     # filesystem | s3
RATE_LIMITER_BACKEND=memory         # memory | redis  (redis = global limit across workers)
REPOSITORY_BACKEND=memory           # memory | postgres

# --- Postgres (D5: PostgreSQL 17, AWS RDS in the cloud, `make up` locally). No SQLite.
DATABASE_URL=postgresql+asyncpg://verifirm:verifirm@localhost:5432/verifirm
# Tests insert rows they never delete (audit is append-only): give them their own database.
# Create it once: createdb -U verifirm verifirm_test. Used automatically by ./conftest.py.
TEST_DATABASE_URL=postgresql+asyncpg://verifirm:verifirm@localhost:5432/verifirm_test
DB_POOL_SIZE=5                      # per process (API replica / worker)
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_ECHO=0

# --- Redis / AWS (D6, D7)
REDIS_URL=redis://localhost:6379/0
# SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/<account>/verifirm-runs
# S3_BUCKET=verifirm-raw-archive
OBJECT_STORE_PATH=.data/objects     # filesystem object store root (git-ignored)
AWS_REGION=eu-central-1

# --- pipeline
AGENT_TIMEOUT_S=60                  # default time budget per agent
# AGENT_TIMEOUTS_S={"litigation": 90, "media": 45}     # per-agent overrides (JSON)
# Local-first (docs/LOCAL_DATA.md): agents read the local mirror only. Sync downloads.
MIRROR_MAX_AGE_S=86400              # mirror copies older than this are refreshed by sync (agents see them as stale)
# MIRROR_MAX_AGE_OVERRIDES_S={"anaf_v9": 43200}      # per-adapter overrides (JSON)
SYNC_TIMEOUT_S=180                  # per adapter, for the pipeline sync step and sync jobs
SYNC_ON_APPLICATION=1               # applications/rechecks download once before agents run
EMBEDDED_WORKER=0                   # 1 = the API also processes the queue (single box / local)
HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=3
# SCORING_CONFIG_PATH=verifirm/scoring/config/weights.yaml

# --- LLM (D3: default Claude via the direct Anthropic API)
LLM_PROVIDER=anthropic              # anthropic | bedrock | openai | openai_compatible | fake
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.featherless.ai/v1
# OPENAI_COMPATIBLE_API_KEY=
LLM_MODEL_DEFAULT=claude-sonnet-5-5
# LLM_MODEL_MEMO=
# LLM_MODEL_CRITIC=
# LLM_MODEL_CLASSIFY=
# LLM_MODEL_ANALYST=                # AI analyst opinion; a large model (e.g. Qwen/Qwen2.5-72B-Instruct)

# --- web search (D10: Tavily)
WEB_SEARCH_PROVIDER=tavily          # tavily | fixture (FIXTURE_MODE=1 always uses fixtures)
TAVILY_API_KEY=

# --- API
API_CORS_ORIGINS=["*"]              # JSON list. Restrict to the Lovable app URL for the demo
FIXTURE_SSE_DELAY_S=0.4             # pacing of the fixture replay of /runs/{id}/events
