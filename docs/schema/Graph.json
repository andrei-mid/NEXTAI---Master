{
  "$defs": {
    "GraphEdge": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "role"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "fictional": {
          "default": false,
          "title": "Fictional",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "company",
        "person"
      ],
      "title": "NodeType",
      "type": "string"
    }
  },
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "Graph",
  "type": "object"
}
