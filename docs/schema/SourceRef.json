{
  "$defs": {
    "SourceType": {
      "enum": [
        "official",
        "aggregator",
        "web",
        "mock",
        "submitted"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/SourceType"
    },
    "url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "raw_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Ref"
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    }
  },
  "required": [
    "name",
    "type",
    "retrieved_at"
  ],
  "title": "SourceRef",
  "type": "object"
}
