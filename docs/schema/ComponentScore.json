    "AgentStatus": {
      "enum": [
        "ok",
        "partial",
        "unavailable",
        "timeout",
        "skipped"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "Component": {
      "enum": [
        "identity",
        "financials",
        "tax",
        "litigation",
        "network",
        "sanctions",
        "media",
        "presence"
      ],
      "title": "Component",
      "type": "string"
    }
  },
  "properties": {
