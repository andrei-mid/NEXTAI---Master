      "default": null,
      "title": "Score"
    },
    "weight": {
      "minimum": 0,
      "title": "Weight",
      "type": "number"
    },
    "effective_weight": {
      "default": 0,
      "minimum": 0,
      "title": "Effective Weight",
      "type": "number"
    },
    "signal_ids": {
      "items": {
        "type": "string"
      },
      "title": "Signal Ids",
      "type": "array"
    }
  },
  "required": [
    "component",
    "status",
    "available",
    "weight"
  ],
  "title": "ComponentScore",
  "type": "object"
}
